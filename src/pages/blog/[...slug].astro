---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={`https://https://www.drdianaclinic.com/blog/${post.slug}`}
>
  <main id="main" class="post-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a> › <a href="/blog">Articles</a> › <span>{post.data.title}</span>
      </nav>

      <header class="post-header">
  <div class="post-meta">
    <time>
      {post.data.pubDate.toLocaleDateString('en-MY', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>

    {(post.data.tags ?? []).map((tag: string) => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  <h1>{post.data.title}</h1>
  <p class="byline">By {post.data.author}</p>

  {post.data.heroImage && (
    <img
      src={post.data.heroImage}
      alt={post.data.title}
      class="hero-img"
      width="1200"
      height="630"
    />
  )}
</header>

      <article class="post-body">
        <Content />
      </article>

      <footer class="post-footer">
        <p class="disclaimer">This article is for informational purposes only and does not constitute medical advice. Individual skin concerns vary — a clinical assessment by a qualified doctor is recommended before starting any treatment.</p>
        <a href="https://wa.me/60183902910?text=Hi%20Diana%20Clinic%2C%20I%20read%20your%20article%20and%20would%20like%20to%20book%20a%20Clinical%20Assessment..." class="cta" target="_blank" rel="noopener">Book a Clinical Assessment →</a>
        <a href="/blog" class="back">← Back to all articles</a>
      </footer>
    </div>
  </main>
</BaseLayout>

<style>
  .post-page { padding: 3rem 0 5rem; }
  .container { max-width: 740px; margin: 0 auto; padding: 0 1.5rem; }
  .breadcrumb { font-size: 0.8rem; color: var(--muted, #6b7280); margin-bottom: 2rem; }
  .breadcrumb a { color: inherit; text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent, #5a7a6a); }
  .post-meta { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; }
  time { font-size: 0.85rem; color: var(--muted, #6b7280); }
  .tag { font-size: 0.7rem; padding: 0.2rem 0.6rem; background: var(--surface, #f4f6f4); border-radius: 999px; color: var(--accent, #5a7a6a); }
  .post-header h1 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 500; line-height: 1.25; margin-bottom: 0.75rem; }
  .byline { font-size: 0.85rem; color: var(--muted, #6b7280); margin-bottom: 2rem; }
  .hero-img { width: 100%; height: auto; border-radius: 8px; margin-bottom: 2.5rem; }
  .post-body { line-height: 1.8; font-size: 1.05rem; }
  .post-body h2 { font-size: 1.35rem; font-weight: 500; margin: 2.5rem 0 0.75rem; }
  .post-body h3 { font-size: 1.1rem; font-weight: 500; margin: 2rem 0 0.5rem; }
  .post-body p { margin-bottom: 1.25rem; }
  .post-body ul, .post-body ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .post-body li { margin-bottom: 0.4rem; }
  .post-body table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
  .post-body th, .post-body td { padding: 0.75rem; border: 1px solid var(--border, #e5e7e6); text-align: left; }
  .post-body th { background: var(--surface, #f4f6f4); font-weight: 500; }
  .post-footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border, #e5e7e6); display: flex; flex-direction: column; gap: 1rem; }
  .disclaimer { font-size: 0.8rem; color: var(--muted, #6b7280); line-height: 1.6; font-style: italic; }
  .cta { display: inline-block; padding: 0.85rem 1.5rem; background: var(--accent, #5a7a6a); color: white; text-decoration: none; border-radius: 6px; font-size: 0.9rem; }
  .back { font-size: 0.85rem; color: var(--accent, #5a7a6a); text-decoration: none; }
.blog-figure {
  margin: 2.5rem 0;
}

.blog-image {
  width: 100%;
  height: auto !important;
  max-width: 100%;
  max-height: 560px;
  object-fit: contain !important;
  display: block;
  border-radius: 18px;
  background: #f7f3ed;
}

.blog-figure figcaption {
  max-width: 760px;
  margin: 0.75rem auto 0;
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--muted, #6b7280);
  text-align: center;
}

</style>