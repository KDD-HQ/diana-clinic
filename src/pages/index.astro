            <p class="doctor-role">{d.role}</p>
            <p class="doctor-practising">{d.practising}</p>
            <p class="doctor-focus"><span>Clinical focus</span>{d.focus}</p>
            <p class="doctor-bio">{d.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section id="how" class="how">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">How we work</p>
        <h2>Three steps, in sequence.</h2>
      </header>
      <ol class="how-steps">
        <li>
          <span class="how-step-num">01</span>
          <h3>Clinical Assessment</h3>
          <p>
            A doctor reads your skin in person. We discuss concerns, history, and lifestyle, and photograph where useful.
            Typically twenty to thirty minutes.
          </p>
        </li>
        <li>
          <span class="how-step-num">02</span>
          <h3>Tailored Protocol or Programme</h3>
          <p>
            A plan is built around your concern, your skin, and your timeline. Protocols are single sessions. Programmes are planned series across weeks or months, with defined endpoints.
          </p>
        </li>
        <li>
          <span class="how-step-num">03</span>
          <h3>Ongoing care</h3>
          <p>
            What you do between protocols matters as much as the protocols themselves. Aftercare, daily skincare, and review appointments are part of the plan.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- TECHNOLOGY -->
  <section class="tech">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">The technology behind our protocols</p>
        <h2>Validated devices, selected by indication.</h2>
      </header>
      <p class="tech-intro">
        Devices are tools, not treatments. The diagnosis and the plan are what determine the outcome — the platform is chosen to fit.
      </p>
      <ul class="tech-grid">
        {technology.map((t) => (
          <li>
            <p class="tech-name">{t.name}</p>
            <p class="tech-note">{t.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">What our patients say</p>
        <h2>Read patient reviews on Google.</h2>
      </header>
      <div class="reviews-grid">
        <a class="review-card" href={`https://search.google.com/local/reviews?placeid=${branches[0].placeId}`} target="_blank" rel="noopener">
          <p class="review-rating">4.9 ★ · 360+ reviews</p>
          <p class="review-branch">Diana Clinic Seremban</p>
          <p class="review-link">Read on Google →</p>
        </a>
        <a class="review-card" href={`https://search.google.com/local/reviews?placeid=${branches[1].placeId}`} target="_blank" rel="noopener">
          <p class="review-rating">5.0 ★ · 180+ reviews</p>
          <p class="review-branch">Diana Clinic Bandar Baru Bangi</p>
          <p class="review-link">Read on Google →</p>
        </a>
      </div>
      <p class="note">
        Reviews are published independently by patients on Google. Individual experiences vary.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="faq">
    <div class="container narrow">
      <header class="section-head">
        <p class="eyebrow">Frequently asked</p>
        <h2>Common questions, answered.</h2>
      </header>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- VISIT -->
  <section id="visit" class="visit">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Visit a clinic</p>
        <h2>Two locations. By appointment.</h2>
      </header>
      <div class="branch-grid">
        {branches.map((b) => (
          <article class="branch-card">
            <div class="branch-map">
              <iframe
                title={`Map of ${b.name}`}
                loading="lazy"
                src={`https://www.google.com/maps/embed/v1/place?key=${mapsKey}&q=place_id:${b.placeId}`}
                allowfullscreen
              ></iframe>
            </div>
            <div class="branch-detail">
              <h3>{b.name}</h3>
              <p class="branch-address">{b.streetAddress}<br />{b.postalCode} {b.addressLocality}, {b.addressRegion}</p>
              <p class="branch-hours">{b.hoursReadable}</p>
              <a
                class="cta"
                href={`${waBase}?text=${encodeURIComponent(b.waMessage)}`}
                target="_blank"
                rel="noopener"
              >
                Book — {b.addressLocality}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
   <script is:inline>
    const revealItems = document.querySelectorAll(
      '.hero .eyebrow, .hero h1, .hero-sub, .hero-cta, .trust-strip, .hero-media, .section-head, .tile, .problem .narrow, .concern-card, .doctor-card, .how-steps li, .tech-intro, .tech-grid li, .review-card, .faq-item, .branch-card, .final-cta .narrow'
    );

    revealItems.forEach((item, index) => {
      item.classList.add('reveal-soft');
      item.style.setProperty('--reveal-delay', `${Math.min(index * 40, 240)}ms`);
    });

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  </script>

  <section class="final-cta">
    <div class="container narrow center">
      <h2>Begin with a Clinical Assessment.</h2>
      <p>
        Skin concerns are read in person. The assessment is the starting point — calm, honest, and without obligation.
      </p>
      <a class="cta" href={waGeneric} target="_blank" rel="noopener">Book via WhatsApp</a>
    </div>
  </section>
<script is:inline>
  const heroInner = document.querySelector('.hero-inner');

  function updateHeroFade() {
    if (!heroInner) return;

    const fadeDistance = Math.min(window.innerHeight * 0.65, 520);
    const progress = Math.min(window.scrollY / fadeDistance, 1);

    heroInner.style.setProperty('--hero-opacity', `${1 - progress}`);
    heroInner.style.setProperty('--hero-lift', `${progress * -18}px`);
  }

  updateHeroFade();
  window.addEventListener('scroll', updateHeroFade, { passive: true });
</script>
<script is:inline>
  const fadeSections = document.querySelectorAll(
    '.hero, .concern-tiles, .problem, .concerns, .doctors, .how, .tech, .reviews, .faq, .visit, .final-cta'
  );

  function updateSectionFade() {
    const viewportHeight = window.innerHeight;

    fadeSections.forEach((section) => {
      const rect = section.getBoundingClientRect();
      const sectionCenter = rect.top + rect.height / 2;
      const viewportCenter = viewportHeight / 2;
      const distance = Math.abs(sectionCenter - viewportCenter);

      const fadeStart = viewportHeight * 0.25;
      const fadeEnd = viewportHeight * 0.85;

      let opacity = 1 - (distance - fadeStart) / (fadeEnd - fadeStart);
      opacity = Math.max(0.28, Math.min(1, opacity));

      const lift = (1 - opacity) * 18;

      section.style.setProperty('--section-opacity', opacity.toFixed(3));
      section.style.setProperty('--section-lift', `${lift}px`);
    });
  }

  updateSectionFade();
  window.addEventListener('scroll', updateSectionFade, { passive: true });
  window.addEventListener('resize', updateSectionFade);
