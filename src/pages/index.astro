const mapsKey = 'AIzaSyClcnvpRUzyDoMWvbwonutjXNO3mpOWquE';
---

<BaseLayout>
  <Fragment slot="page-schema">
    {branchSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {physicianSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Medical Aesthetic Clinic · Since 2016</p>
        <h1>Acne, pigmentation, scars, and aging skin — read by a doctor first.</h1>
        <p class="hero-sub">
          Clinical assessment and evidence-based protocols at Klinik Dr Diana. Two clinics — Seremban and Bandar Baru Bangi — doctor-led since 2016.
        </p>
        <div class="hero-cta">
          <a class="cta" href={waGeneric} target="_blank" rel="noopener">Book a Clinical Assessment</a>
          <a class="cta cta--ghost" href="#how">How we work</a>
        </div>
        <ul class="trust-strip" aria-label="Clinic credentials">
          <li><strong>4.9 ★</strong> · 540+ Google reviews</li>
          <li>KKM-licensed</li>
          <li>LCP-certified doctors</li>
          <li>Since 2016</li>
        </ul>
      </div>
      <div class="hero-media">
        <img
          src="/images/hero/hero-treatment-room-seremban.jpg"
          alt="Treatment room at Klinik Dr Diana — calm, doctor-led aesthetic care in Seremban and Bandar Baru Bangi."
          width="1200"
          height="1600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- CONCERN TILES -->
  <section class="concern-tiles">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Start here</p>
        <h2>Which concern brings you in?</h2>
      </header>
      <div class="tile-grid">
        {concerns.map((c) => (
          <a href={`#${c.id}`} class="tile">
            <h3>{c.title}</h3>
            <p>{c.lead}</p>
            <span class="tile-link">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem">
    <div class="container narrow">
      <h2>Most skin concerns do not respond to general approaches.</h2>
      <p>
        Pigmentation deepens. Acne returns. Scars settle into texture. Skin ages.
        The difference a clinical setting makes is not a stronger machine — it is a diagnosis.
        Skin is read first, then treated, by a doctor, with a plan that belongs to one patient at a time.
      </p>
    </div>
  </section>

  <!-- CONCERNS -->
  <section id="concerns" class="concerns">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">What we work in</p>
        <h2>Five concerns. One clinical approach.</h2>
      </header>
      <div class="concerns-grid">
        {concerns.map((c) => (
  <article id={c.id} class="concern-card">
    <h3>
      {c.articles.length > 0 ? (
        <a class="concern-title-link" href={c.articles[0].href}>
          {c.title}
        </a>
      ) : (
        c.title
      )}
    </h3>

    <p>{c.body}</p>

    {c.articles.length > 0 && (
      <div class="concern-articles">
        <span class="concern-articles-label">Related guides</span>

        <ul>
          {c.articles.map((article) => (
            <li>
              <a href={article.href}>{article.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
))}
      </div>
      <p class="note">
        Every condition is read in person. Treatment plans are tailored, evidence-based, and explained in full before any protocol begins.
      </p>
    </div>
  </section>

  <!-- DOCTORS -->
  <section id="doctors" class="doctors">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Your doctors</p>
        <h2>The doctors behind Klinik Dr Diana.</h2>
      </header>
      <div class="doctors-grid">
        {doctors.map((d) => (
          <article class="doctor-card">
            <img
              class="doctor-portrait"
