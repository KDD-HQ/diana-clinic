---
import BaseLayout from '../layouts/BaseLayout.astro';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

// — Branch records (single source of truth) —
const branches = [
  {
    id: 'seremban',
    name: 'Diana Clinic Seremban',
    legalName: 'Klinik Dr Diana Senawang',
    streetAddress: 'No 32-G-1, Jalan BPS 3, Bandar Prima Senawang',
    addressLocality: 'Seremban',
    addressRegion: 'Negeri Sembilan',
    postalCode: '70450',
    lat: 2.7015376,
    lng: 101.9807122,
    placeId: 'ChIJD8fhHinhzTERPVTvF7e8VRE',
    hours: ['Mo-Fr 09:30-18:00', 'Sa 10:00-18:00'],
    hoursReadable: 'Mon–Fri 9:30am – 6:00pm · Sat 10:00am – 6:00pm · Sun closed',
    waMessage: "Hi Diana Clinic, I'd like to book a Clinical Assessment at the Seremban branch, and my concern is..."
  },
  {
    id: 'bangi',
    name: 'Diana Clinic Bandar Baru Bangi',
    legalName: 'Klinik Dr Diana Bangi',
    streetAddress: 'UG-3a, Gandaria Mall, Jalan Pusat Bandar 2, Sunway Gandaria, Seksyen 9',
    addressLocality: 'Bandar Baru Bangi',
    addressRegion: 'Selangor',
    postalCode: '43650',
    lat: 2.9617989,
    lng: 101.7529975,
    placeId: 'ChIJ23411NnLzTERaDnTAJXyTVA',
    hours: ['Mo 09:00-17:30', 'Tu 09:00-14:00', 'Th-Su 09:00-17:30'],
    hoursReadable: 'Mon 9:00am – 5:30pm · Tue 9:00am – 2:00pm · Wed closed · Thu–Sun 9:00am – 5:30pm',
    waMessage: "Hi Diana Clinic, I'd like to book a Clinical Assessment at the Bangi branch, and my concern is..."
  }
];

import { waLink } from '../config/whatsapp-cta';
const waGeneric = waLink('home');
const waUnsure = waGeneric;

// — Concerns (simplified for homepage tiles — full article lists live on pillar pages) —
const concerns = [
  {
    id: 'pigmentation',
    title: 'Pigmentation & Melasma',
    short: 'Melasma · dark patches · uneven tone',
    href: '/blog/pigmentation-dark-patches-guide/',
    img: '/images/concerns/pigmentation.jpg'
  },
  {
    id: 'acne',
    title: 'Acne',
    short: 'Active breakouts · recurring acne',
    href: '/treatments/acne',
    img: '/images/concerns/acne.jpg'
  },
  {
    id: 'acne-scars',
    title: 'Acne Scars',
    short: 'Texture · depth · tethered scars',
    href: '/treatments/deep-scar-treatment',
    img: '/images/concerns/acne-scars.jpg'
  },
  {
    id: 'aging-skin',
    title: 'Aging Skin',
    short: 'Lines · laxity · tone · firmness',
    href: '#how',
    img: '/images/concerns/aging-skin.jpg'
  },
  {
    id: 'skin-booster',
    title: 'Skin Booster & Glow',
    short: 'Hydration · radiance · texture',
    href: '/blog/skin-booster-what-is-skin-booster/',
    img: '/images/concerns/skin-booster.jpg'
  }
];

// — Star treatments (horizontal carousel) —
const starTreatments = [
  { name: 'Pico Laser', for: 'Pigmentation · tone', href: '/treatments', img: '/images/hero/hero-treatment-room-seremban.jpg' },
  { name: 'Fractional CO2', for: 'Acne scars · resurfacing', href: '/treatments/deep-scar-treatment', img: '/images/hero/hero-treatment-room-seremban.jpg' },
  { name: 'Subcision', for: 'Rolling · tethered scars', href: '/treatments/deep-scar-treatment', img: '/images/hero/hero-treatment-room-seremban.jpg' },
  { name: 'Rejuran', for: 'Skin quality · healing', href: '/blog/skin-booster-rejuran-treatment-malaysia/', img: '/images/hero/hero-treatment-room-seremban.jpg' },
  { name: 'Profhilo', for: 'Hydration · firmness', href: '/blog/skin-booster-profhilo-vs-skin-booster/', img: '/images/hero/hero-treatment-room-seremban.jpg' },
  { name: 'OxyGeneo Facial', for: 'Glow · skin quality', href: '/treatments/oxygeneo-glam-facial', img: '/images/hero/hero-treatment-room-seremban.jpg' }
];

// — Google review quotes —
const reviews = [
  { text: "After a week I can see the acne is completely gone, skin is bright and glow. Very recommend for anyone who has breakout problems.", name: 'Izzati I.' },
  { text: "I started the deep scar treatment for almost a year now. Scars improved a lot and I'm planning to renew the scar treatment package to get smoother skin!", name: 'Muhammad Q.' },
  { text: "First time here for deep scar treatment and I would say highly recommended for an aesthetic clinic. Surely I will come again for another treatment.", name: 'Nat N. · Senawang' },
  { text: "After just a few sessions, my acne has improved significantly. They carefully assessed my skin and recommended treatments tailored to my needs.", name: 'Norliyana R.' },
  { text: "They explained to me well on my skin problems, and I can see the difference on my skin just 2 to 3 weeks after the first treatment.", name: 'Nuruul Athira B.' }
];

// — Results (horizontal carousel) —
const results = [
  { src: '/images/treatments/pigmentation/results/pigmentation-result-01.jpg', alt: 'Before and after melasma treatment result', condition: 'Melasma', detail: '4 sessions' },
  { src: '/images/results/acne/acne-result-01.jpg', alt: 'Before and after acne treatment result', condition: 'Acne', detail: '3 months' },
  { src: '/images/results/acne-scars/acne-scar-result-01.jpg', alt: 'Before and after acne scar treatment result', condition: 'Acne Scars', detail: '6 sessions' },
  { src: '/images/treatments/pigmentation/results/pigmentation-result-04.jpg', alt: 'Before and after pigmentation treatment result', condition: 'Pigmentation', detail: '5 sessions' },
  { src: '/images/results/acne/acne-result-03.jpg', alt: 'Before and after acne treatment showing improvement', condition: 'Acne', detail: '2 months' },
  { src: '/images/results/keratosis/keratosis-result-01.jpg', alt: 'Before and after keratosis removal result', condition: 'Keratosis', detail: '1 session' }
];

const doctors = [
  {
    name: 'Dr Diana Abd Razak',
    role: 'Founder · Lead Aesthetic Doctor',
    photo: '/images/doctors/dr-diana-abd-razak.jpg',
    practising: 'Medical doctor since 2009 · in aesthetic medicine since 2015',
    focus: 'Pigmentation & melasma, skin restoration, anti-aging programmes',
    bio: 'Founding doctor of Klinik Dr Diana. LCP-certified medical aesthetic practitioner.'
  },
  {
    name: 'Dr Shahrill Effendy',
    role: 'Aesthetic Doctor',
    photo: '/images/doctors/dr-effendy.jpg',
    practising: 'Medical doctor since 2009 · in aesthetic medicine since 2018',
    focus: 'Acne & acne-scar restoration, anti-aging, skin quality',
    bio: 'LCP-certified medical aesthetic practitioner at Klinik Dr Diana.'
  }
];

const faqs = [
  { q: 'Is the clinic licensed by the Ministry of Health?', a: 'Yes. Klinik Dr Diana is fully licensed under the Ministry of Health Malaysia, and our doctors are LCP-certified medical aesthetic practitioners.' },
  { q: 'What conditions do you treat most often?', a: 'Our work is concentrated in four areas: acne and acne-scar management, melasma and pigmentation, aging skin, and overall skin quality and restoration. We have particular depth in acne-scar restoration, where most patients require a planned programme rather than a single protocol.' },
  { q: 'How do I know which treatment is right for my skin?', a: 'Every skin is read in person before a plan is suggested. The Clinical Assessment is a structured evaluation — concerns, history, and photography where useful — that leads to a tailored protocol or programme. We do not prescribe a treatment menu before we have read the skin.' },
  { q: 'Will there be downtime after a protocol?', a: 'Downtime depends on the protocol. Most of our work is minimal-downtime — mild redness or slight swelling that typically resolves within hours. More resurfacing protocols carry longer recovery, and this is discussed in full before any decision is made.' },
  { q: 'How long do the results last?', a: 'Longevity depends on the condition and the protocol. Pigmentation and melasma are managed conditions and benefit from ongoing care. Acne-scar restoration is durable once the texture is rebuilt. Aging is a process — programmes are paced to maintain, not to chase a single outcome. Individual results vary.' },
  { q: 'Is pricing transparent?', a: 'Yes. Pricing is itemised and discussed in full during the Clinical Assessment. There are no obligations following the assessment, and no programme is committed to without a full understanding of the cost.' },
  { q: 'Where are you located?', a: 'Two clinics. Seremban (Bandar Prima Senawang) and Bandar Baru Bangi (Gandaria Mall, Seksyen 9). Appointments at both clinics are arranged via WhatsApp.' }
];

// — Page-specific JSON-LD —
const branchSchemas = branches.map((b) => ({
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'LocalBusiness'],
  '@id': `${site}/#${b.id}`,
  name: b.name,
  parentOrganization: { '@id': `${site}/#organization` },
  url: site,
  image: `${site}/og/diana-clinic-og.jpg`,
  telephone: '+60183902910',
  priceRange: '$$$',
  medicalSpecialty: ['Dermatology', 'CosmeticDermatology'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: b.streetAddress,
    addressLocality: b.addressLocality,
    addressRegion: b.addressRegion,
    postalCode: b.postalCode,
    addressCountry: 'MY'
  },
  geo: { '@type': 'GeoCoordinates', latitude: b.lat, longitude: b.lng },
  openingHours: b.hours,
  areaServed: { '@type': 'Country', name: 'Malaysia' }
}));

const physicianSchemas = doctors.map((d) => ({
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: d.name,
  worksFor: { '@id': `${site}/#organization` },
  medicalSpecialty: 'CosmeticDermatology',
  description: d.bio
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' }
  ]
};

const mapsKey = 'AIzaSyClcnvpRUzyDoMWvbwonutjXNO3mpOWquE';
---

<BaseLayout>
  <Fragment slot="page-schema">
    {branchSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    {physicianSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- ============================== -->
  <!-- 1. HERO — full-bleed, mobile-first -->
  <!-- ============================== -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src="/images/hero/hero-treatment-room-seremban.jpg"
        alt="Treatment room at Klinik Dr Diana — calm, doctor-led aesthetic care in Seremban and Bandar Baru Bangi."
        width="1200"
        height="1600"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-overlay">
      <div class="container">
        <p class="eyebrow">Medical Aesthetic Clinic · Since 2016</p>
        <h1>Acne, pigmentation, scars, and aging skin — read by a doctor first.</h1>
        <p class="hero-sub">
          Clinical assessment and evidence-based protocols at Klinik Dr Diana.
          Two clinics — Seremban and Bandar Baru Bangi — doctor-led since 2016.
        </p>
        <!-- CTA 1 -->
        <div class="hero-cta">
          <a class="cta" href={waGeneric} target="_blank" rel="noopener">Book a Clinical Assessment</a>
          <a class="cta cta--ghost-light" href="#how">How we work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 2. TRUST BAR -->
  <!-- ============================== -->
  <div class="trust-bar">
    <div class="container">
      <ul class="trust-bar-list" aria-label="Clinic credentials">
        <li><strong>4.9 ★</strong> 540+ reviews</li>
        <li><strong>KKM</strong> licensed</li>
        <li><strong>LCP</strong> certified</li>
        <li><strong>Since</strong> 2016</li>
      </ul>
    </div>
  </div>

  <!-- ============================== -->
  <!-- 3. GOOGLE REVIEWS CAROUSEL -->
  <!-- ============================== -->
  <section class="reviews" id="reviews">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">What patients say</p>
        <h2>Real reviews from Google.</h2>
      </header>
    </div>
    <div class="scroll-row reviews-scroll">
      {reviews.map((r) => (
        <blockquote class="review-quote-card">
          <p class="review-stars" aria-label="5 out of 5 stars">★★★★★</p>
          <p class="review-text">"{r.text}"</p>
          <cite class="review-cite">— {r.name} · Google Review</cite>
        </blockquote>
      ))}
    </div>
    <!-- CTA 2 -->
    <div class="container section-cta">
      <div class="branch-reviews-row">
        <a class="review-branch-link" href={`https://search.google.com/local/reviews?placeid=${branches[0].placeId}`} target="_blank" rel="noopener">
          <strong>4.9 ★ · 360+</strong> Seremban reviews →
        </a>
        <a class="review-branch-link" href={`https://search.google.com/local/reviews?placeid=${branches[1].placeId}`} target="_blank" rel="noopener">
          <strong>5.0 ★ · 180+</strong> Bangi reviews →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 4. CONCERN CARDS — visual tiles -->
  <!-- ============================== -->
  <section class="concerns" id="concerns">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Start here</p>
        <h2>Which concern brings you in?</h2>
      </header>
      <div class="concern-grid">
        {concerns.map((c) => (
          <a href={c.href} class={`concern-tile ${c.id === 'skin-booster' ? 'concern-tile--wide' : ''}`}>
            <div class="concern-tile-img">
              <img src={c.img} alt={`${c.title} treatment concern`} width="400" height="300" loading="lazy" />
            </div>
            <div class="concern-tile-text">
              <h3>{c.title}</h3>
              <p>{c.short}</p>
            </div>
          </a>
        ))}
      </div>
      <!-- CTA 3 -->
      <div class="section-cta center">
        <a class="cta cta--whatsapp" href={waUnsure} target="_blank" rel="noopener">Not sure? Tell us your concern</a>
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 5. STAR TREATMENTS CAROUSEL -->
  <!-- ============================== -->
  <section class="treatments-popular">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Popular treatments</p>
        <h2>What patients come in for most.</h2>
      </header>
    </div>
    <div class="scroll-row treatments-scroll">
      {starTreatments.map((t) => (
        <a href={t.href} class="treatment-card">
          <div class="treatment-card-img">
            <img src={t.img} alt={`${t.name} treatment at Klinik Dr Diana`} width="320" height="240" loading="lazy" />
          </div>
          <div class="treatment-card-text">
            <h3>{t.name}</h3>
            <p>{t.for}</p>
          </div>
        </a>
      ))}
    </div>
    <!-- CTA 4 -->
    <div class="container section-cta center">
      <a class="cta cta--outline" href="/treatments">View all treatments →</a>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 6. PHOTO BREAK -->
  <!-- ============================== -->
  <div class="photo-break">
    <img
      src="/images/hero/photo-break-consultation.jpg"
      alt="Doctor consulting with patient at Klinik Dr Diana."
      width="1200"
      height="600"
      loading="lazy"
    />
  </div>

  <!-- ============================== -->
  <!-- 7. RESULTS CAROUSEL -->
  <!-- ============================== -->
  <section class="results" id="results">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Real results</p>
        <h2>What improvement looks like.</h2>
      </header>
      <p class="note note--top">Results vary by individual. These photos show real patients treated at our clinics. Individual assessment is required.</p>
    </div>
    <div class="scroll-row results-scroll">
      {results.map((r) => (
        <div class="result-card">
          <img src={r.src} alt={r.alt} width="400" height="300" loading="lazy" />
          <div class="result-card-label">
            <strong>{r.condition}</strong>
            <span>{r.detail}</span>
          </div>
        </div>
      ))}
    </div>
    <!-- CTA 5 — peak conversion -->
    <div class="container section-cta center">
      <a class="cta cta--whatsapp" href={waGeneric} target="_blank" rel="noopener">Discuss your skin with our doctors</a>
      <a class="cta cta--text" href="/results">See all patient results →</a>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 8. DOCTORS -->
  <!-- ============================== -->
  <section class="doctors" id="doctors">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Your doctors</p>
        <h2>The doctors behind Klinik Dr Diana.</h2>
      </header>
      <div class="doctors-grid">
        {doctors.map((d) => (
          <article class="doctor-card">
            <img
              class="doctor-portrait"
              src={d.photo}
              alt={`Portrait of ${d.name}, ${d.role}, at Klinik Dr Diana.`}
              width="320"
              height="320"
              loading="lazy"
            />
            <h3>{d.name}</h3>
            <p class="doctor-role">{d.role}</p>
            <p class="doctor-practising">{d.practising}</p>
            <p class="doctor-focus"><span>Clinical focus</span>{d.focus}</p>
            <p class="doctor-bio">{d.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 9. HOW WE WORK -->
  <!-- ============================== -->
  <section class="how" id="how">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">How we work</p>
        <h2>Three steps, in sequence.</h2>
      </header>
      <ol class="how-steps">
        <li>
          <span class="how-step-num">01</span>
          <h3>Clinical Assessment</h3>
          <p>A doctor reads your skin in person. We discuss concerns, history, and lifestyle, and photograph where useful. Typically twenty to thirty minutes.</p>
        </li>
        <li>
          <span class="how-step-num">02</span>
          <h3>Tailored Protocol or Programme</h3>
          <p>A plan is built around your concern, your skin, and your timeline. Protocols are single sessions. Programmes are planned series across weeks or months, with defined endpoints.</p>
        </li>
        <li>
          <span class="how-step-num">03</span>
          <h3>Ongoing care</h3>
          <p>What you do between protocols matters as much as the protocols themselves. Aftercare, daily skincare, and review appointments are part of the plan.</p>
        </li>
      </ol>
      <!-- CTA 6 — anxiety removed -->
      <div class="section-cta center">
        <a class="cta cta--whatsapp" href={waGeneric} target="_blank" rel="noopener">Start with step 1 — book assessment</a>
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 10. FAQ -->
  <!-- ============================== -->
  <section class="faq" id="faq">
    <div class="container narrow">
      <header class="section-head">
        <p class="eyebrow">Frequently asked</p>
        <h2>Common questions, answered.</h2>
      </header>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <!-- CTA 7 — catch cautious visitors -->
      <div class="section-cta center">
        <a class="cta cta--outline" href={waGeneric} target="_blank" rel="noopener">Still have questions? WhatsApp us</a>
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 11. VISIT -->
  <!-- ============================== -->
  <section class="visit" id="visit">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Visit a clinic</p>
        <h2>Two locations. By appointment.</h2>
      </header>
      <div class="branch-grid">
        {branches.map((b) => (
          <article class="branch-card">
            <div class="branch-map">
              <iframe
                title={`Map of ${b.name}`}
                loading="lazy"
                src={`https://www.google.com/maps/embed/v1/place?key=${mapsKey}&q=place_id:${b.placeId}`}
                allowfullscreen
              ></iframe>
            </div>
            <div class="branch-detail">
              <h3>{b.name}</h3>
              <p class="branch-address">{b.streetAddress}<br />{b.postalCode} {b.addressLocality}, {b.addressRegion}</p>
              <p class="branch-hours">{b.hoursReadable}</p>
              <a
                class="cta"
                href={waGeneric}
                target="_blank"
                rel="noopener"
              >
                Book – {b.addressLocality}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== -->
  <!-- 12. FINAL CTA -->
  <!-- ============================== -->
  <section class="final-cta">
    <div class="container narrow center">
      <h2>Begin with a Clinical Assessment.</h2>
      <p>
        Skin concerns are read in person. The assessment is the starting point — calm, honest, and without obligation.
      </p>
      <a class="cta" href={waGeneric} target="_blank" rel="noopener">Book via WhatsApp</a>
    </div>
  </section>

  <!-- ============================== -->
  <!-- REVEAL ANIMATION -->
  <!-- ============================== -->
  <script is:inline>
    const revealEls = document.querySelectorAll(
      '.section-head, .concern-tile, .doctor-card, .how-steps li, .faq-item, .branch-card, .final-cta .narrow'
    );
    revealEls.forEach((el) => el.classList.add('reveal'));
    const revealObs = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObs.unobserve(e.target); } }),
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => revealObs.observe(el));
  </script>

  <!-- ============================== -->
  <!-- STYLES — mobile-first -->
  <!-- ============================== -->
  <style>
    /* ——— HERO — full-bleed photo ——— */
    .hero {
      position: relative;
      min-height: 85vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }
    @media (min-width: 880px) {
      .hero { min-height: 90vh; }
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      filter: saturate(0.9);
    }
    .hero-overlay {
      position: relative;
      z-index: 1;
      width: 100%;
      padding: var(--space-5) 0 var(--space-4);
      background: linear-gradient(to top, rgba(31, 26, 21, 0.85) 0%, rgba(31, 26, 21, 0.55) 50%, transparent 100%);
    }
    .hero .eyebrow {
      color: rgba(255, 247, 237, 0.7);
    }
    .hero h1 {
      color: #fff7ed;
      font-size: clamp(1.8rem, 5vw, 3.4rem);
      max-width: 680px;
    }
    .hero-sub {
      color: rgba(255, 247, 237, 0.85);
      font-size: 1rem;
      line-height: 1.65;
      max-width: 560px;
      margin: 0 0 var(--space-3);
    }
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .cta--ghost-light {
      background: transparent;
      color: #fff7ed;
      border-color: rgba(255, 247, 237, 0.4);
    }
    .cta--ghost-light:hover {
      background: rgba(255, 247, 237, 0.12);
    }

    /* ——— TRUST BAR ——— */
    .trust-bar {
      background: var(--color-anchor);
      padding: 0.7rem 0;
    }
    .trust-bar-list {
