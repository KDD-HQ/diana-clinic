---
// ============================================================
// src/pages/treatments/index.astro
// Treatments hub — lists all published treatments.
// Uses BaseLayout so global header/nav/footer stay consistent.
// ============================================================

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const treatments = await getCollection('treatments', ({ data }) => !data.draft);

// Sort by category, then alphabetically
treatments.sort((a, b) => {
  if (a.data.category !== b.data.category)
    return a.data.category.localeCompare(b.data.category);

  return a.data.title.localeCompare(b.data.title);
});

const SITE = 'https://www.drdianaclinic.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Treatments',
      item: `${SITE}/treatments`,
    },
  ],
};
---

<BaseLayout
  title="Treatments | Klinik Dr Diana"
  description="Doctor-supervised medical aesthetic treatments at Klinik Dr Diana — Bandar Baru Bangi and Senawang. Acne, acne scars, pigmentation, skin boosters and anti-aging treatments."
  canonical={`${SITE}/treatments`}
>
  <Fragment slot="page-schema">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="hero treatments-intro">
    <div class="container">
      <div class="eyebrow">Treatments</div>

      <h1>Our treatments</h1>

      <p class="lead">
        Doctor-supervised medical aesthetic protocols at Klinik Dr Diana —
        covering acne, acne scars, pigmentation, skin boosters, facial rejuvenation
        and anti-aging across our Bandar Baru Bangi and Senawang branches.
      </p>
    </div>
  </section>

  <main class="container treatments-main">
    <div class="treatment-grid">
      {treatments.map((t) => (
        <a href={`/treatments/${t.slug}`} class="treatment-card">
          <div class="treatment-card__image">
            <img
              src={t.data.heroImage}
              alt={t.data.heroImageAlt}
              loading="lazy"
            />
          </div>

          <div class="treatment-card__body">
            <div class="treatment-card__eyebrow">{t.data.category}</div>
            <h2 class="treatment-card__title">{t.data.title}</h2>
            <p class="treatment-card__desc">{t.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  :root {
    --bg: #fbf8f4;
    --ink: #1a1f2e;
    --muted: #5a6478;
    --accent: #b8895a;
    --accent-dark: #8a6438;
    --line: #e8e1d4;
    --card: #ffffff;
  }

  .hero {
    background: linear-gradient(135deg, #faf3e7 0%, #f5e9d4 100%);
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 3rem;
  }

  .hero .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-dark);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.4rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .hero .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 640px;
  }

  .treatments-main {
    margin-bottom: 4rem;
  }

  .treatment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .treatment-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .treatment-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .treatment-card__image {
    aspect-ratio: 3 / 2;
    background: #f7f3ed;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .treatment-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .treatment-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .treatment-card__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-dark);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .treatment-card__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    color: var(--ink);
    line-height: 1.25;
  }

  .treatment-card__desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* ============================================================
     Treatments page intro animation
     Top "Our treatments" section: fade + slide right
     Treatment cards: fade only
     Duration: 0.2s
     ============================================================ */

  @keyframes treatmentsSlideRight {
    from {
      opacity: 0;
      transform: translateX(-70px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes treatmentsFadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .treatments-intro .container {
    animation: treatmentsSlideRight 0.2s ease-out both;
  }

  .treatment-card {
    animation: treatmentsFadeIn 0.2s ease-out both;
  }

  .treatment-card:nth-child(1) {
    animation-delay: 0.03s;
  }

  .treatment-card:nth-child(2) {
    animation-delay: 0.06s;
  }

  .treatment-card:nth-child(3) {
    animation-delay: 0.09s;
  }

  .treatment-card:nth-child(n + 4) {
    animation-delay: 0.12s;
  }

  @media (prefers-reduced-motion: reduce) {
    .treatments-intro .container,
    .treatment-card {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>