---
// ============================================================
// src/pages/treatments/index.astro
// Treatments hub — lists all published treatments.
// Minimal first version; style and expand later.
// ============================================================

import { getCollection } from 'astro:content';

const treatments = await getCollection('treatments', ({ data }) => !data.draft);

// Sort by category, then alphabetically
treatments.sort((a, b) => {
  if (a.data.category !== b.data.category)
    return a.data.category.localeCompare(b.data.category);
  return a.data.title.localeCompare(b.data.title);
});

const SITE = 'https://www.drdianaclinic.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Treatments', item: `${SITE}/treatments` },
  ],
};
---

<!DOCTYPE html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Treatments | Klinik Dr Diana</title>
    <meta
      name="description"
      content="Doctor-supervised medical aesthetic treatments at Klinik Dr Diana — Bandar Baru Bangi and Senawang. Acne, acne scars, pigmentation, anti-aging."
    />
    <link rel="canonical" href={`${SITE}/treatments`} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>

  <body>
    <!-- TODO: replace with your existing site header/nav component -->

    <section class="hero">
      <div class="container">
        <div class="eyebrow">Treatments</div>
        <h1>Our treatments</h1>
        <p class="lead">
          Doctor-supervised medical aesthetic protocols at Klinik Dr Diana —
          covering acne, acne scars, pigmentation, and anti-aging across our
          Bandar Baru Bangi and Senawang branches.
        </p>
      </div>
    </section>

    <main class="container">
      <div class="treatment-grid">
        {treatments.map((t) => (
          <a href={`/treatments/${t.slug}`} class="treatment-card">
            <div class="treatment-card__image">
              <img src={t.data.heroImage} alt={t.data.heroImageAlt} loading="lazy" />
            </div>
            <div class="treatment-card__body">
              <div class="treatment-card__eyebrow">{t.data.category}</div>
              <h2 class="treatment-card__title">{t.data.title}</h2>
              <p class="treatment-card__desc">{t.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </main>

    <footer>
      <div class="container">
        © Klinik Dr Diana · KKM-licensed aesthetic medical clinic · Bandar Baru
        Bangi & Senawang
      </div>
    </footer>

    <style>
      :root {
        --bg: #fbf8f4;
        --ink: #1a1f2e;
        --muted: #5a6478;
        --accent: #b8895a;
        --accent-dark: #8a6438;
        --line: #e8e1d4;
        --card: #ffffff;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.65;
        font-size: 17px;
      }
      h1, h2 { font-family: 'Fraunces', Georgia, serif; font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }
      h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin-bottom: 1rem; }
      .container { max-width: 960px; margin: 0 auto; padding: 0 1.25rem; }

      .hero {
        background: linear-gradient(135deg, #faf3e7 0%, #f5e9d4 100%);
        padding: 4rem 0 3rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 3rem;
      }
      .hero .eyebrow {
        font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase;
        color: var(--accent-dark); font-weight: 600; margin-bottom: 1rem;
      }
      .hero .lead { font-size: 1.15rem; color: var(--muted); max-width: 640px; }

      .treatment-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 4rem;
      }
      .treatment-card {
        background: var(--card); border: 1px solid var(--line);
        border-radius: 12px; overflow: hidden; text-decoration: none;
        color: var(--ink); transition: transform 0.2s, box-shadow 0.2s;
      }
      .treatment-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.06);
      }
      .treatment-card__image {
        aspect-ratio: 4 / 3; background: #f7f3ed; overflow: hidden;
      }
      .treatment-card__image img {
        width: 100%; height: 100%; object-fit: cover; display: block;
      }
      .treatment-card__body { padding: 1.25rem 1.5rem 1.5rem; }
      .treatment-card__eyebrow {
        font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--accent-dark); font-weight: 600; margin-bottom: 0.5rem;
      }
      .treatment-card__title {
        font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--ink);
      }
      .treatment-card__desc {
        font-size: 0.9rem; color: var(--muted); line-height: 1.5;
      }

      footer {
        padding: 3rem 0; text-align: center; color: var(--muted);
        font-size: 0.85rem; border-top: 1px solid var(--line); margin-top: 4rem;
      }
    </style>
  </body>
</html>
