---
// ============================================================
// ResultsLayout.astro
// Layout for dedicated results gallery pages (/results/acne,
// /results/pigmentation, etc.)
//
// Wraps BaseLayout. Auto-generates JSON-LD:
//   - MedicalWebPage
//   - ImageGallery
//   - BreadcrumbList
//   - FAQPage (if faqs provided)
//
// Usage in a results page:
//   <ResultsLayout
//     title="Acne Treatment Results"
//     description="Before and after photos..."
//     condition="Acne"
//     conditionBM="Jerawat"
//     slug="acne"
//     heroImage="/images/results/acne/acne-result-01.jpg"
//     faqs={[{ q: "...", a: "..." }]}
//   >
//     <!-- page content -->
//   </ResultsLayout>
// ============================================================

import BaseLayout from './BaseLayout.astro';

interface FAQ {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  condition: string;
  conditionBM?: string;
  slug: string;
  heroImage?: string;
  faqs?: FAQ[];
}

const {
  title,
  description,
  condition,
  conditionBM,
  slug,
  heroImage,
  faqs = [],
} = Astro.props;

const siteUrl = 'https://drdianaclinic.com';
const canonicalUrl = `${siteUrl}/results/${slug}`;
const ogImage = heroImage ? `${siteUrl}${heroImage}` : `${siteUrl}/images/og-default.jpg`;

// JSON-LD: MedicalWebPage
const medicalWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "mainEntity": {
    "@type": "MedicalCondition",
    "name": condition,
    ...(conditionBM && { "alternateName": conditionBM }),
  },
  "lastReviewed": new Date().toISOString().split('T')[0],
  "reviewedBy": {
    "@type": "Physician",
    "name": "Dr Diana Abd Razak",
    "medicalSpecialty": "Aesthetic Medicine",
    "qualifications": "MD, LCP MOH Malaysia, PGCert Primary Care Dermatology, PGCert Aesthetic Medicine"
  },
  "publisher": {
    "@type": "MedicalBusiness",
    "name": "Klinik Dr Diana",
    "url": siteUrl
  }
};

// JSON-LD: ImageGallery
const imageGallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": `${condition} Treatment Results — Klinik Dr Diana`,
  "description": `Before and after photos of ${condition.toLowerCase()} treatment results at Klinik Dr Diana. Results vary by individual.`,
  "url": canonicalUrl,
  "publisher": {
    "@type": "MedicalBusiness",
    "name": "Klinik Dr Diana"
  }
};

// JSON-LD: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Results", "item": `${siteUrl}/results` },
    { "@type": "ListItem", "position": 3, "name": `${condition} Results`, "item": canonicalUrl },
  ]
};

// JSON-LD: FAQPage (if faqs provided)
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
} : null;
---

<BaseLayout title={title} description={description}>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(imageGallerySchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  )}

  <!-- OG + Meta -->
  <meta property="og:title" content={title} slot="head" />
  <meta property="og:description" content={description} slot="head" />
  <meta property="og:url" content={canonicalUrl} slot="head" />
  <meta property="og:image" content={ogImage} slot="head" />
  <meta property="og:type" content="website" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <link rel="canonical" href={canonicalUrl} slot="head" />

  <main class="results-page">
    <!-- Breadcrumb -->
    <nav class="results-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/results">Results</a></li>
        <li aria-current="page">{condition}</li>
      </ol>
    </nav>

    <slot />

    <!-- Compliance disclaimer -->
    <aside class="results-disclaimer">
      <p>
        <strong>Disclaimer:</strong> All before and after photos are from real patients of Klinik Dr Diana, 
        shown with written consent. Individual results vary depending on skin type, condition severity, 
        and treatment adherence. These photos are for illustrative purposes and do not guarantee 
        specific outcomes. An in-person consultation and assessment is required before any treatment 
        plan can be confirmed.
      </p>
    </aside>

    <!-- CTA -->
    <section class="results-cta" aria-label="Book consultation">
      <h2>Want to know what's possible for your skin?</h2>
      <p>
        Book a consultation with our doctors to discuss your concerns 
        and receive a personalised assessment.
      </p>
      <div class="results-cta__buttons">
        <a
          href="https://api.whatsapp.com/send?phone=60183902910&text=Hi%20Klinik%20Dr%20Diana%0A%0A%5BChannel%3A%20WEB%5D%0A%0ASaya%20ingin%20bertanya%20mengenai%20%2F%20I%20want%20to%20ask%20regarding%3A"
          class="btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp Us — Bangi
        </a>
        <a
          href="https://api.whatsapp.com/send?phone=60183902910&text=Hi%20Klinik%20Dr%20Diana%0A%0A%5BChannel%3A%20WEB%5D%0A%0ASaya%20ingin%20bertanya%20mengenai%20%2F%20I%20want%20to%20ask%20regarding%3A"
          class="btn btn--secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp Us — Senawang
        </a>
      </div>
      <p class="results-cta__note">
        Medically reviewed by Dr Diana Abd Razak, MD, LCP, PGCert Dermatology, PGCert Aesthetic Medicine
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .results-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Breadcrumb */
  .results-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted, #6b6b6b);
  }

  .results-breadcrumb li:not(:last-child)::after {
    content: "›";
    margin-left: 0.4rem;
  }

  .results-breadcrumb a {
    color: var(--color-text-muted, #6b6b6b);
    text-decoration: none;
  }

  .results-breadcrumb a:hover {
    color: var(--color-accent, #2c6e5a);
  }

  .results-breadcrumb [aria-current="page"] {
    color: var(--color-text-heading, #1a1a1a);
    font-weight: 500;
  }

  /* Disclaimer */
  .results-disclaimer {
    margin: 3rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg-alt, #fafaf8);
    border-left: 3px solid var(--color-accent, #2c6e5a);
    border-radius: 4px;
    font-size: 0.82rem;
    color: var(--color-text-muted, #6b6b6b);
    line-height: 1.6;
  }

  .results-disclaimer p {
    margin: 0;
  }

  /* CTA */
  .results-cta {
    text-align: center;
    padding: 3rem 1.5rem;
    margin: 2rem 0;
    background: var(--color-bg-alt, #fafaf8);
    border-radius: 12px;
  }

  .results-cta h2 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-text-heading, #1a1a1a);
    margin: 0 0 0.75rem;
  }

  .results-cta > p {
    font-size: 0.95rem;
    color: var(--color-text-body, #333);
    margin: 0 0 1.5rem;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .results-cta__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background: var(--color-accent, #2c6e5a);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--color-accent-dark, #245a49);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-accent, #2c6e5a);
    border: 1.5px solid var(--color-accent, #2c6e5a);
  }

  .btn--secondary:hover {
    background: var(--color-accent, #2c6e5a);
    color: #fff;
  }

  .results-cta__note {
    font-size: 0.75rem;
    color: var(--color-text-muted, #6b6b6b);
    margin-top: 1.25rem;
  }

  @media (max-width: 600px) {
    .results-page {
      padding: 1.5rem 1rem 3rem;
    }

    .results-cta h2 {
      font-size: 1.2rem;
    }

    .results-cta__buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>