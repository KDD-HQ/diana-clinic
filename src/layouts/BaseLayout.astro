---
const {
  title = 'Dr Diana Clinic · Doctor-led aesthetic care in Seremban & Bangi',
  description = 'Clinical assessment and evidence-based protocols for pigmentation, acne, acne scars, and aging skin. Doctor-led aesthetic care since 2016.',
  ogImage = '/og/diana-clinic-og.jpg',
  canonical = Astro.url.href
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Auto-tagged WhatsApp CTA — resolves the correct pre-fill from the URL path
import { waLinkForPath } from '../config/whatsapp-cta';
const waHref = waLinkForPath(Astro.url.pathname);

// Global JSON-LD — Organization + WebSite (rendered on every page)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Dr Diana Clinic',
  alternateName: 'Klinik Dr Diana',
  url: site,
  logo: `${site}/brand/diana-clinic-wordmark.svg`,
  foundingDate: '2016',
  sameAs: [
    'https://www.instagram.com/drdianaclinic/',
    'https://www.instagram.com/drdianaclinicresult/',
    'https://www.facebook.com/DRDIANACLINIC/'
  ]
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: 'Dr Diana Clinic',
  publisher: { '@id': `${site}/#organization` },
  inLanguage: 'en-MY'
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Bilingual readiness (BM site to follow on /ms/) -->
    <link rel="alternate" hreflang="en-MY" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Open Graph + Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta property="og:locale" content="en_MY" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon (replace once SVG mark is finalised) -->
    <!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />

    <!-- Global structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Page-specific JSON-LD injected by pages -->
    <slot name="page-schema" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="Dr Diana Clinic, home">
          <span class="wordmark-primary">Dr Diana Clinic</span>
        </a>

        <button
          class="menu-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="primary-nav"
          onclick="const e=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',(!e).toString());document.querySelector('.nav-list').classList.toggle('open')"
        >☰</button>

        <nav aria-label="Primary" id="primary-nav">
          <ul class="nav-list">
            <li><a href="/">Home</a></li>
            <li><a href="/#concerns">Concerns</a></li>

            <li class="has-dropdown">
              <a href="/treatments" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
                Treatments <span class="chevron" aria-hidden="true">▾</span>
              </a>
              <div class="dropdown-panel dropdown-panel--mega" role="menu">
                <div class="dropdown-grid">
                  <div class="dropdown-col">
                    <p class="dropdown-heading">Pigmentation</p>
                    <ul>
                      <li><a href="/treatments/pigmentation">Pigmentation &amp; Melasma</a></li>
                      <li><a href="/treatments/lhala-peel">Lhala Peel</a></li>
                    </ul>
                  </div>
                  <div class="dropdown-col">
                    <p class="dropdown-heading">Acne &amp; Scars</p>
                    <ul>
                      <li><a href="/treatments/acne">Acne Treatment</a></li>
                      <li><a href="/treatments/deep-scar-treatment">Deep Acne Scar Treatment</a></li>
                    </ul>
                  </div>
                  <div class="dropdown-col">
                    <p class="dropdown-heading">Anti-Aging &amp; Lifting</p>
                    <ul>
                      <li><a href="/treatments/radiesse-biostimulator">Radiesse Biostimulator</a></li>
                      <li><a href="/treatments/novuma-biostimulator">Novuma Biostimulator</a></li>
                      <li><a href="/treatments/liftera-v-hifu">Liftera V HIFU</a></li>
                      <li><a href="/treatments/profhilo-structura-fat-stimulator">Profhilo Structura</a></li>
                    </ul>
                  </div>
                  <div class="dropdown-col">
                    <p class="dropdown-heading">Skin Quality &amp; Rejuvenation</p>
                    <ul>
                      <li><a href="/treatments/juvelook-biostimulator">Juvelook Biostimulator</a></li>
                      <li><a href="/treatments/plenhyage-strong-xl">Plenhyage Strong XL</a></li>
                      <li><a href="/treatments/hyalual-electri">Hyalual Electri</a></li>
                      <li><a href="/treatments/oxygeneo-glam">Oxygeneo Glam</a></li>
                      <li><a href="/treatments/silkpeel-dermalinfusion">SilkPeel Dermalinfusion</a></li>
                      <li><a href="/treatments/dark-eye-circle-treatment">Dark Eye Circle Treatment</a></li>
                    </ul>
                  </div>
                </div>
                <div class="dropdown-footer">
                  <a href="/treatments" class="dropdown-view-all">View all treatments →</a>
                </div>
              </div>
            </li>

            <li><a href="/#doctors">Doctors</a></li>
            <li><a href="/#how">How we work</a></li>
            <li><a href="/#faq">FAQ</a></li>

            <li class="has-dropdown">
              <a href="/results" class="dropdown-trigger" aria-haspopup="true" aria-expanded="false">
                Results <span class="chevron" aria-hidden="true">▾</span>
              </a>
              <div class="dropdown-panel" role="menu">
                <ul class="dropdown-simple">
                  <li><a href="/results">All Results</a></li>
                  <li><a href="/results/pigmentation">Pigmentation Results</a></li>
                  <li><a href="/results/acne">Acne Results</a></li>
                  <li><a href="/results/acne-scars">Acne Scar Results</a></li>
<li><a href="/results/skin-growths-lesions">Skin Growths &amp; Lesions Results</a></li>
                </ul>
              </div>
            </li>

            <li><a href="/#visit">Visit</a></li>
            <li><a href="/blog">Blog</a></li>

            <li class="nav-cta-mobile">
              <a class="cta cta--compact"
                 href={waHref}
                 target="_blank"
                 rel="noopener">
                Book Assessment
              </a>
            </li>
          </ul>
        </nav>

        <a class="cta cta--compact nav-cta-desktop"
           href={waHref}
           target="_blank"
           rel="noopener">
          Book Assessment
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="wordmark-primary footer-mark">Dr Diana Clinic</p>
          <p class="footer-fineprint">
            DEM Ventures Sdn Bhd · SSM 1190890-D<br />
            Licensed under the Ministry of Health Malaysia (LCP / KKM)
          </p>
        </div>
        <div>
          <p class="footer-heading">Seremban</p>
          <p class="footer-fineprint">
            No 32-G-1, Jalan BPS 3,<br />
            Bandar Prima Senawang,<br />
            70450 Seremban, Negeri Sembilan
          </p>
        </div>
        <div>
          <p class="footer-heading">Bandar Baru Bangi</p>
          <p class="footer-fineprint">
            UG-3a, Gandaria Mall,<br />
            Jalan Pusat Bandar 2, Seksyen 9,<br />
            43650 Bangi, Selangor
          </p>
        </div>
        <div>
          <p class="footer-heading">Follow</p>
          <ul class="footer-links">
            <li><a href="https://www.instagram.com/drdianaclinic/" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://www.facebook.com/DRDIANACLINIC/" target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-legal">
        <p>
          The information on this website is for general educational purposes and does not replace professional medical advice.
          Outcomes vary by individual; an in-person clinical assessment is required before any treatment recommendation.
        </p>
        <p>© {new Date().getFullYear()} DEM Ventures Sdn Bhd. All rights reserved.</p>
      </div>
    </footer>

    <!-- Sticky WhatsApp -->
    <a class="sticky-wa"
       href={waHref}
       target="_blank"
       rel="noopener"
       aria-label="Book a Clinical Assessment via WhatsApp">
      <span>WhatsApp</span>
    </a>

    <!-- Mobile dropdown accordion behavior -->
    <script is:inline>
      (function () {
        const isMobile = () => window.matchMedia('(max-width: 768px)').matches;

        // Toggle dropdown on tap (mobile only); allow normal navigation on desktop
        document.querySelectorAll('.has-dropdown > .dropdown-trigger').forEach((trigger) => {
          trigger.addEventListener('click', (e) => {
            if (isMobile()) {
              e.preventDefault();
              const parent = trigger.parentElement;
              const wasOpen = parent.classList.contains('is-open');
              // Close any other open dropdowns
              document.querySelectorAll('.has-dropdown.is-open').forEach((el) => el.classList.remove('is-open'));
              if (!wasOpen) parent.classList.add('is-open');
              trigger.setAttribute('aria-expanded', (!wasOpen).toString());
            }
          });
        });

        // Close mobile menu when any real link is tapped
        document.querySelectorAll('.nav-list a').forEach((link) => {
          link.addEventListener('click', () => {
            if (isMobile() && !link.classList.contains('dropdown-trigger')) {
              const nav = document.querySelector('.nav-list');
              const toggle = document.querySelector('.menu-toggle');
              nav?.classList.remove('open');
              toggle?.setAttribute('aria-expanded', 'false');
            }
          });
        });

        // Close dropdowns when clicking outside (desktop safety)
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.has-dropdown')) {
            document.querySelectorAll('.has-dropdown.is-open').forEach((el) => el.classList.remove('is-open'));
          }
        });
      })();
    </script>

    <style is:global>
      :root {
        --color-surface: #F2EBDD;
        --color-surface-alt: #EFE7D6;
        --color-ink: #1F1A15;
        --color-anchor: #34203F;
        --color-anchor-soft: #4A2F58;
        --color-layer: #DDD2BC;
        --color-whisper: #A8AC95;

        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Jost', system-ui, -apple-system, sans-serif;

        --space-1: 0.5rem;
        --space-2: 1rem;
        --space-3: 1.5rem;
        --space-4: 2.5rem;
        --space-5: 4rem;
        --space-6: 6rem;

        --maxw: 1180px;
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--color-surface);
        color: var(--color-ink);
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 16px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; }

      img, svg { max-width: 100%; display: block; }

      .container {
        width: 100%;
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 var(--space-3);
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        background: var(--color-anchor);
        color: var(--color-surface);
        padding: 0.5rem 1rem;
      }
      .skip-link:focus { left: 1rem; top: 1rem; z-index: 1000; }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(242, 235, 221, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-layer);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-top: var(--space-2);
        padding-bottom: var(--space-2);
      }
      .wordmark { text-decoration: none; display: flex; flex-direction: column; line-height: 1.1; }
      .wordmark-primary {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1.6rem;
        color: var(--color-anchor);
        letter-spacing: 0.01em;
      }
      .wordmark-secondary {
        font-family: var(--font-body);
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-anchor-soft);
        margin-top: 0.25rem;
      }
      .nav-list {
        display: none;
        gap: var(--space-3);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.92rem;
        align-items: center;
      }

      /* Hamburger menu - mobile */
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 1.8rem;
        cursor: pointer;
        color: var(--color-anchor);
        padding: 0.25rem 0.5rem;
        line-height: 1;
      }

      .nav-list a { text-decoration: none; color: var(--color-ink); }
      .nav-list a:hover { color: var(--color-anchor); }

      /* =========================================
         DROPDOWNS
         ========================================= */
      .has-dropdown { position: relative; }

      .dropdown-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
      }
      .chevron {
        font-size: 0.7em;
        transition: transform 0.2s ease;
        display: inline-block;
      }

      .dropdown-panel {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background: rgba(242, 235, 221, 0.98);
        backdrop-filter: blur(12px);
        border: 1px solid var(--color-layer);
        border-top: 2px solid var(--color-anchor);
        padding: var(--space-3);
        min-width: 240px;
        box-shadow: 0 12px 32px rgba(31, 26, 21, 0.12);
        z-index: 51;
      }

      .dropdown-panel--mega {
        left: 50%;
        transform: translateX(-50%);
        min-width: min(880px, 92vw);
        padding: var(--space-4) var(--space-4) var(--space-3);
      }

      /* Show dropdown on hover, keyboard focus, or JS-added .is-open */
      .has-dropdown:hover > .dropdown-panel,
      .has-dropdown:focus-within > .dropdown-panel,
      .has-dropdown.is-open > .dropdown-panel {
        display: block;
      }
      .has-dropdown:hover .chevron,
      .has-dropdown:focus-within .chevron,
      .has-dropdown.is-open .chevron {
        transform: rotate(180deg);
      }

      .dropdown-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-3);
      }
      .dropdown-col ul,
      .dropdown-simple {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .dropdown-heading {
        font-family: var(--font-body);
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--color-anchor-soft);
        margin: 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-layer);
        font-weight: 500;
      }
      .dropdown-col a,
      .dropdown-simple a {
        font-size: 0.88rem;
        color: var(--color-ink);
        text-decoration: none;
        line-height: 1.4;
        transition: color 0.15s ease;
      }
      .dropdown-col a:hover,
      .dropdown-simple a:hover {
        color: var(--color-anchor);
      }
      .dropdown-footer {
        margin-top: var(--space-3);
        padding-top: var(--space-2);
        border-top: 1px solid var(--color-layer);
        text-align: right;
      }
      .dropdown-view-all {
        font-size: 0.82rem;
        color: var(--color-anchor);
        text-decoration: none;
        font-weight: 500;
        letter-spacing: 0.02em;
      }
      .dropdown-view-all:hover { text-decoration: underline; }

      .nav-cta-mobile { display: none; }

      /* =========================================
         MOBILE (≤768px)
         ========================================= */
      @media (max-width: 768px) {
        .menu-toggle { display: block; }
        .nav-list {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          align-items: stretch;
          background: rgba(242, 235, 221, 0.98);
          backdrop-filter: blur(10px);
          padding: 1rem 1.5rem 1.5rem;
          gap: 1rem;
          border-bottom: 1px solid var(--color-layer);
          box-shadow: 0 4px 20px rgba(0,0,0,0.08);
          max-height: calc(100vh - 60px);
          overflow-y: auto;
        }
        .nav-list.open { display: flex; }
        .site-header { position: relative; }
        .nav-cta-desktop { display: none; }

        /* Mobile dropdown = inline accordion, not floating panel */
        .dropdown-panel,
        .dropdown-panel--mega {
          position: static;
          transform: none;
          left: auto;
          min-width: 0;
          width: 100%;
          background: transparent;
          backdrop-filter: none;
          border: none;
          border-top: 1px solid var(--color-layer);
          box-shadow: none;
          padding: 0.75rem 0 0.5rem 1rem;
          margin-top: 0.5rem;
        }
        .dropdown-grid {
          grid-template-columns: 1fr;
          gap: var(--space-2);
        }
        .dropdown-heading {
          margin-top: 0.5rem;
        }
        .dropdown-col:first-child .dropdown-heading { margin-top: 0; }
        .dropdown-footer {
          text-align: left;
          margin-top: var(--space-2);
          padding-top: var(--space-1);
        }

        .nav-cta-mobile {
          display: block;
          margin-top: 0.75rem;
        }
        .nav-cta-mobile .cta {
          display: block;
          text-align: center;
        }
      }

      @media (min-width: 769px) {
        .nav-list { display: flex; }
      }

      /* CTAs */
      .cta {
        display: inline-block;
        background: var(--color-anchor);
        color: var(--color-surface);
        text-decoration: none;
        padding: 0.85rem 1.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        border: 1px solid var(--color-anchor);
        transition: background 0.2s ease;
      }
      .cta:hover { background: var(--color-anchor-soft); }
      .cta--compact { padding: 0.6rem 1.1rem; font-size: 0.82rem; }
      .cta--ghost {
        background: transparent;
        color: var(--color-anchor);
      }
      .cta--ghost:hover { background: var(--color-layer); }

      /* Footer */
      .site-footer {
        background: var(--color-anchor);
        color: var(--color-surface);
        margin-top: 0;
        padding: var(--space-5) 0 var(--space-3);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
      @media (min-width: 720px) {
        .footer-grid { grid-template-columns: repeat(4, 1fr); }
      }
      .footer-mark { color: var(--color-surface); font-size: 1.4rem; margin: 0 0 var(--space-1); }
      .footer-heading {
        font-family: var(--font-body);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        margin: 0 0 var(--space-1);
        color: var(--color-layer);
      }
      .footer-fineprint {
        font-size: 0.86rem;
        line-height: 1.7;
        color: var(--color-layer);
        margin: 0;
      }
      .footer-links { list-style: none; padding: 0; margin: 0; }
      .footer-links a { color: var(--color-layer); text-decoration: none; font-size: 0.86rem; }
      .footer-links a:hover { color: var(--color-surface); }
      .footer-legal {
        border-top: 1px solid rgba(221, 210, 188, 0.2);
        margin-top: var(--space-4);
        padding-top: var(--space-3);
        font-size: 0.78rem;
        color: var(--color-layer);
      }
      .footer-legal p { margin: 0 0 var(--space-1); }

      /* Sticky WhatsApp */
      .sticky-wa {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        background: var(--color-anchor);
        color: var(--color-surface);
        padding: 0.85rem 1.3rem;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        box-shadow: 0 8px 24px rgba(31, 26, 21, 0.18);
        z-index: 60;
      }

      /* Shared section rhythm */
      section {
        padding: var(--space-6) 0;
      }
      section + section { border-top: 1px solid var(--color-layer); }
    </style>
  </body>
</html>