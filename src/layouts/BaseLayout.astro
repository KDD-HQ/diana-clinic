---
const {
  title = 'Diana Clinic · Doctor-led aesthetic care in Seremban & Bangi',
  description = 'Clinical assessment and evidence-based protocols for pigmentation, acne, acne scars, and aging skin. Doctor-led aesthetic care since 2016.',
  ogImage = '/og/diana-clinic-og.jpg',
  canonical = Astro.url.href
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Global JSON-LD — Organization + WebSite (rendered on every page)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Diana Clinic',
  alternateName: 'Klinik Dr Diana',
  url: site,
  logo: `${site}/brand/diana-clinic-wordmark.svg`,
  foundingDate: '2016',
  sameAs: [
    'https://www.instagram.com/drdianaclinic/',
    'https://www.instagram.com/drdianaclinicresult/',
    'https://www.facebook.com/DRDIANACLINIC/'
  ]
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: 'Diana Clinic',
  publisher: { '@id': `${site}/#organization` },
  inLanguage: 'en-MY'
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Bilingual readiness (BM site to follow on /ms/) -->
    <link rel="alternate" hreflang="en-MY" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Open Graph + Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta property="og:locale" content="en_MY" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon (replace once SVG mark is finalised) -->
    <link rel="icon" href="/favicon.ico" />

    <!-- Global structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Page-specific JSON-LD injected by pages -->
    <slot name="page-schema" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="Diana Clinic, home">
          <span class="wordmark-primary">Diana Clinic</span>
          <span class="wordmark-secondary">Klinik Dr Diana · Seremban · Bandar Baru Bangi</span>
        </a>
        <nav aria-label="Primary">
          <ul class="nav-list">
            <li><a href="#concerns">Concerns</a></li>
            <li><a href="#doctors">Doctors</a></li>
            <li><a href="#how">How we work</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#visit">Visit</a></li>
          <li><a href="/blog">Blog</a></li>
          </ul>
        </nav>
        
          <a class="cta cta--compact"
          href="https://wa.me/60183902910?text=Hi%20Diana%20Clinic%2C%20I'd%20like%20to%20book%20a%20Clinical%20Assessment%2C%20and%20my%20concern%20is..."
          target="_blank"
          rel="noopener"
        >
          Book Assessment
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="wordmark-primary footer-mark">Diana Clinic</p>
          <p class="footer-fineprint">
            Klinik Dr Diana Sdn Bhd · SSM 1190890-D<br />
            Licensed under the Ministry of Health Malaysia (LCP / KKM)
          </p>
        </div>
        <div>
          <p class="footer-heading">Seremban</p>
          <p class="footer-fineprint">
            No 32-G-1, Jalan BPS 3,<br />
            Bandar Prima Senawang,<br />
            70450 Seremban, Negeri Sembilan
          </p>
        </div>
        <div>
          <p class="footer-heading">Bandar Baru Bangi</p>
          <p class="footer-fineprint">
            UG-3a, Gandaria Mall,<br />
            Jalan Pusat Bandar 2, Seksyen 9,<br />
            43650 Bangi, Selangor
          </p>
        </div>
        <div>
          <p class="footer-heading">Follow</p>
          <ul class="footer-links">
            <li><a href="https://www.instagram.com/drdianaclinic/" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://www.facebook.com/DRDIANACLINIC/" target="_blank" rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-legal">
        <p>
          The information on this website is for general educational purposes and does not replace professional medical advice.
          Outcomes vary by individual; an in-person clinical assessment is required before any treatment recommendation.
        </p>
        <p>© {new Date().getFullYear()} Klinik Dr Diana Sdn Bhd. All rights reserved.</p>
      </div>
    </footer>

    <!-- Sticky WhatsApp -->
    
      class="sticky-wa"
      href="https://wa.me/60183902910?text=Hi%20Diana%20Clinic%2C%20I'd%20like%20to%20book%20a%20Clinical%20Assessment%2C%20and%20my%20concern%20is..."
      target="_blank"
      rel="noopener"
      aria-label="Book a Clinical Assessment via WhatsApp"
    >
      <span>WhatsApp</span>
    </a>

    <style is:global>
      :root {
        --color-surface: #F2EBDD;
        --color-surface-alt: #EFE7D6;
        --color-ink: #1F1A15;
        --color-anchor: #34203F;
        --color-anchor-soft: #4A2F58;
        --color-layer: #DDD2BC;
        --color-whisper: #A8AC95;

        --font-display: 'Cormorant Garamond', Georgia, serif;
        --font-body: 'Jost', system-ui, -apple-system, sans-serif;

        --space-1: 0.5rem;
        --space-2: 1rem;
        --space-3: 1.5rem;
        --space-4: 2.5rem;
        --space-5: 4rem;
        --space-6: 6rem;

        --maxw: 1180px;
      }

      *,
      *::before,
      *::after { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--color-surface);
        color: var(--color-ink);
        font-family: var(--font-body);
        font-weight: 400;
        font-size: 16px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; }

      img, svg { max-width: 100%; display: block; }

      .container {
        width: 100%;
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 var(--space-3);
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        background: var(--color-anchor);
        color: var(--color-surface);
        padding: 0.5rem 1rem;
      }
      .skip-link:focus { left: 1rem; top: 1rem; z-index: 1000; }

      /* Header */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(242, 235, 221, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-layer);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-top: var(--space-2);
        padding-bottom: var(--space-2);
      }
      .wordmark { text-decoration: none; display: flex; flex-direction: column; line-height: 1.1; }
      .wordmark-primary {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1.6rem;
        color: var(--color-anchor);
        letter-spacing: 0.01em;
      }
      .wordmark-secondary {
        font-family: var(--font-body);
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-anchor-soft);
        margin-top: 0.25rem;
      }
      .nav-list {
        display: none;
        gap: var(--space-3);
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.92rem;
      }
      .nav-list a { text-decoration: none; color: var(--color-ink); }
      .nav-list a:hover { color: var(--color-anchor); }
      @media (min-width: 880px) {
        .nav-list { display: flex; }
      }

      /* CTAs */
      .cta {
        display: inline-block;
        background: var(--color-anchor);
        color: var(--color-surface);
        text-decoration: none;
        padding: 0.85rem 1.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        border: 1px solid var(--color-anchor);
        transition: background 0.2s ease;
      }
      .cta:hover { background: var(--color-anchor-soft); }
      .cta--compact { padding: 0.6rem 1.1rem; font-size: 0.82rem; }
      .cta--ghost {
        background: transparent;
        color: var(--color-anchor);
      }
      .cta--ghost:hover { background: var(--color-layer); }

      /* Footer */
      .site-footer {
        background: var(--color-anchor);
        color: var(--color-surface);
        margin-top: var(--space-6);
        padding: var(--space-5) 0 var(--space-3);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
      @media (min-width: 720px) {
        .footer-grid { grid-template-columns: repeat(4, 1fr); }
      }
      .footer-mark { color: var(--color-surface); font-size: 1.4rem; margin: 0 0 var(--space-1); }
      .footer-heading {
        font-family: var(--font-body);
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        margin: 0 0 var(--space-1);
        color: var(--color-layer);
      }
      .footer-fineprint {
        font-size: 0.86rem;
        line-height: 1.7;
        color: var(--color-layer);
        margin: 0;
      }
      .footer-links { list-style: none; padding: 0; margin: 0; }
      .footer-links a { color: var(--color-layer); text-decoration: none; font-size: 0.86rem; }
      .footer-links a:hover { color: var(--color-surface); }
      .footer-legal {
        border-top: 1px solid rgba(221, 210, 188, 0.2);
        margin-top: var(--space-4);
        padding-top: var(--space-3);
        font-size: 0.78rem;
        color: var(--color-layer);
      }
      .footer-legal p { margin: 0 0 var(--space-1); }

      /* Sticky WhatsApp */
      .sticky-wa {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        background: var(--color-anchor);
        color: var(--color-surface);
        padding: 0.85rem 1.3rem;
        border-radius: 999px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        box-shadow: 0 8px 24px rgba(31, 26, 21, 0.18);
        z-index: 60;
      }

      /* Shared section rhythm */
      section {
        padding: var(--space-6) 0;
      }
      section + section { border-top: 1px solid var(--color-layer); }
    </style>
  </body>
</html>